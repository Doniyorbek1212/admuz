# Sado billing service. Copy to .env for local development; in staging/production inject these
# from the secret manager. Never commit real values.

SADO_BILLING_ENVIRONMENT=development            # development | test | staging | production
SADO_BILLING_DATABASE_URL=postgresql+asyncpg://sado:sado@localhost:5432/sado_billing
SADO_BILLING_REDIS_URL=redis://localhost:6379/2
SADO_BILLING_JWT_SECRET=                         # required, >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
SADO_BILLING_ACCESS_TOKEN_TTL_SECONDS=1800
SADO_BILLING_LINK_CODE_TTL_SECONDS=300

# Payments master switch. Keep false until store verification (phase B) is configured and tested.
SADO_BILLING_PAYMENTS_ENABLED=false
# JSON list. "mock" is rejected in staging/production at startup.
SADO_BILLING_ENABLED_PROVIDERS=[]
SADO_BILLING_MOCK_WEBHOOK_SECRET=                # development/test only
SADO_BILLING_WEBHOOK_MAX_AGE_SECONDS=300

# Google Play Developer API (phase B)
SADO_BILLING_GOOGLE_PACKAGE_NAME=
SADO_BILLING_GOOGLE_SERVICE_ACCOUNT_FILE=        # path to a mounted secret file, not the JSON itself

# App Store Server API (phase B)
SADO_BILLING_APPLE_BUNDLE_ID=
SADO_BILLING_APPLE_ISSUER_ID=
SADO_BILLING_APPLE_KEY_ID=
SADO_BILLING_APPLE_PRIVATE_KEY_FILE=             # path to the .p8 key file

# AI Writer (phase D). 0 disables all AI spend.
SADO_BILLING_AI_RESERVATION_TTL_SECONDS=120
SADO_BILLING_AI_MONTHLY_BUDGET_MICROS=0

SADO_BILLING_RATE_LIMIT_PER_MINUTE=30

# Hub ads (manual card transfer, approved by an admin in the app)
SADO_BILLING_AD_PRICE_PER_REGION_DAY_UZS=20000
SADO_BILLING_AD_PAYMENT_CARD=                   # card number advertisers transfer to
SADO_BILLING_AD_PAYMENT_CARD_HOLDER=
SADO_BILLING_MEDIA_DIR=media                    # receipts (private) + product media (public); persistent volume
SADO_BILLING_MAX_IMAGE_BYTES=5242880
SADO_BILLING_MAX_VIDEO_BYTES=31457280
SADO_BILLING_SHOP_FREE_LIMIT=2
SADO_BILLING_EXTRA_SHOP_PRICE_UZS=150000

# Whole request body cap (bytes), refused before multipart parsing. Must be >= the biggest upload.
SADO_BILLING_MAX_REQUEST_BYTES=33554432
# false = only login/password sessions reach the admin API (logout and expiry end all access).
SADO_BILLING_ADMIN_PERMANENT_KEYS=true
# Reverse proxy address/subnet trusted for X-Forwarded-For (uvicorn). Required in staging/production; never '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
